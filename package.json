{
  "name": "medula",
  "version": "0.2.0",
  "packageManager": "pnpm@12.3.4",
  "description": "Headless devtools that let a coding agent read and change the state of an open web page through MCP",
  "keywords": [
    "mcp",
    "devtools",
    "devframe",
    "agent",
    "state",
    "vue",
    "react",
    "svelte",
    "solid",
    "nuxt",
    "next"
  ],
  "homepage": "https://github.com/posva/medula",
  "bugs": {
    "url": "https://github.com/posva/medula/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Eduardo San Martin Morote",
    "email": "posva13@gmail.com"
  },
  "repository": "posva/medula",
  "funding": "https://github.com/sponsors/posva",
  "files": [
    "dist",
    "dist-client",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./next": "./dist/next.mjs",
    "./nuxt": "./dist/nuxt.mjs",
    "./vite": "./dist/vite.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build --config panel.vite.config.ts",
    "build:lib": "tsdown",
    "build:panel": "vite build --config panel.vite.config.ts",
    "dev": "vitest --ui",
    "test": "pnpm run build && pnpm run test:cov && pnpm run test:types --force",
    "test:cov": "vitest run --coverage",
    "test:types": "tsc --build ./tsconfig.json",
    "lint": "oxlint ${CI:+--deny-warnings} .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt",
    "prepare": "simple-git-hooks",
    "release": "node scripts/release.ts",
    "prepublishOnly": "pnpm run build",
    "play:vue": "pnpm -C playgrounds/vue-vite dev",
    "play:react": "pnpm -C playgrounds/react-vite dev",
    "play:next": "pnpm -C playgrounds/nextjs dev",
    "play:nuxt": "pnpm -C playgrounds/nuxt dev",
    "e2e:agent": "node e2e/agent.mjs",
    "e2e:agent:codex": "node e2e/agent.mjs --agent codex",
    "play:svelte": "pnpm -C playgrounds/svelte-vite dev",
    "play:solid": "pnpm -C playgrounds/solid-vite dev",
    "e2e:agent:vue": "node e2e/agent.mjs --scenario vue",
    "e2e:agent:svelte": "node e2e/agent.mjs --scenario svelte",
    "e2e:agent:solid": "node e2e/agent.mjs --scenario solid"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@vitejs/devtools-kit": "^0.7.3",
    "devframe": "file:vendor/devframe-0.9.19.tgz",
    "zod": "^4.6.4"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.0.0 || ^5.0.0-0",
    "next": "^15.0.0 || ^16.0.0",
    "pinia": "^3.0.0 || ^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0",
    "vite": "^7.0.0 || ^8.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "pinia": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@devframes/next": "file:vendor/devframes-next-0.9.19.tgz",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "@posva/prompts": "^2.4.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/semver": "^7.8.0",
    "@vitejs/devtools": "^0.7.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "happy-dom": "^20.12.0",
    "lint-staged": "^17.4.1",
    "next": "^16.3.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.80.0",
    "oxlint-plugin-posva": "^0.0.2",
    "pinia": "^4.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "simple-git-hooks": "^2.14.0",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.0",
    "tsdown": "^0.23.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.42"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node scripts/verifyCommit.js"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern --fix"
    ]
  }
}
