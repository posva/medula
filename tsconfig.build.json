{
  "extends": "./tsconfig.common.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "declaration": true,
    "isolatedModules": true,
    "isolatedDeclarations": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./.tsc-types/src",
    "noEmit": false,
    "jsx": "react-jsx",
    "paths": {
      "mcp-devtools": ["./src/index.ts"],
      "mcp-devtools/*": ["./src/*/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/panel/**/*"]
}
